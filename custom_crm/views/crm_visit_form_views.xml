    <record id="view_crm_visit_form_form" model="ir.ui.view">
        <field name="name">crm.visit.form.form</field>
        <field name="model">crm.visit.form</field>
        <field name="arch" type="xml">
            <form string="Visit Form">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <field name="active" invisible="1"/>

                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>

                    <group>
                        <group>
                            <field name="visit_date"/>
                            <field name="visit_type"/>
                            <field name="customer_id" options="{'no_create_edit': False}"/>
                        </group>
                        <group>
                            <field name="contact_person"/>
                            <field name="contact_number" widget="phone"/>
                            <field name="email_address" widget="email"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>

                    <group>
                        <field name="address" placeholder="Customer address..."/>
                    </group>

                    <group invisible="visit_type">
                        <div class="alert alert-info" role="alert" colspan="2">
                            Select a Type to display its related item section.
                        </div>
                    </group>

                    <group string="Rapid Test Items" invisible="visit_type != 'rapid_test'">
                        <field name="rapid_test_line_ids" nolabel="1" colspan="2">
                            <list editable="bottom" string="Rapid Test Items">
                                <field name="sequence" widget="handle"/>
                                <field name="item_name"/>
                                <field name="current_supplier_id"/>
                                <field name="qty"/>
                                <field name="price"/>
                                <field name="currency_id" column_invisible="True"/>
                                                            <field name="note" />

                            </list>
                        </field>
                    </group>

                    <group string="UBT Items" invisible="visit_type != 'ubt'">
                        <field name="ubt_line_ids" nolabel="1" colspan="2">
                            <list editable="bottom" string="UBT Items">
                                <field name="sequence" widget="handle"/>
                                <field name="item_name"/>
                                <field name="current_supplier_id"/>
                                <field name="price"/>
                                <field name="currency_id" column_invisible="True"/>
                                                            <field name="note" />

                            </list>
                        </field>
                    </group>

                    <group string="CLIA Items" invisible="visit_type != 'clia'">
                        <field name="clia_line_ids" nolabel="1" colspan="2">
                            <list editable="bottom" string="CLIA Items">
                                <field name="sequence" widget="handle"/>
                                <field name="item_name"/>
                                <field name="current_supplier_id"/>
                                <field name="qty"/>
                                <field name="price"/>
                                <field name="currency_id" column_invisible="True"/>
                                                            <field name="note" />

                            </list>
                        </field>
                    </group>

                    <group string="ELISA Items" invisible="visit_type != 'elisa'">
                        <field name="elisa_line_ids" nolabel="1" colspan="2">
                            <list editable="bottom" string="ELISA Items">
                                <field name="sequence" widget="handle"/>
                                <field name="item_name"/>
                                <field name="current_supplier_id"/>
                                <field name="price"/>
                                <field name="currency_id" column_invisible="True"/>
                                                            <field name="note" />

                            </list>
                        </field>
                    </group>

                    <group string="Consumables Items" invisible="visit_type != 'consumables'">
                        <field name="consumables_line_ids" nolabel="1" colspan="2">
                            <list editable="bottom" string="Consumables Items">
                                <field name="sequence" widget="handle"/>
                                <field name="item_name"/>
                                <field name="current_supplier_id"/>
                                <field name="qty"/>
                                <field name="price"/>
                                <field name="currency_id" column_invisible="True"/>
                                                            <field name="note" />

                            </list>
                        </field>
                    </group>

                    <group string="POCT Items" invisible="visit_type != 'poct'">
                        <field name="poct_line_ids" nolabel="1" colspan="2">
                            <list editable="bottom" string="POCT Items">
                                <field name="sequence" widget="handle"/>
                                <field name="item_name"/>
                                <field name="current_supplier_id"/>
                                <field name="qty"/>
                                <field name="price"/>
                                <field name="currency_id" column_invisible="True"/>
                                                            <field name="note" />

                            </list>
                        </field>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_crm_visit_form" model="ir.actions.act_window">
        <field name="name">Visit Forms</field>
        <field name="res_model">crm.visit.form</field>
        <field name="view_mode">list,form</field>
<!--        <field name="search_view_id" ref="view_crm_visit_form_search"/>-->
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first CRM visit form.
            </p>
            <p>
                Select a visit type to display only its dedicated item fields.
            </p>
        </field>
    </record>
</odoo>
