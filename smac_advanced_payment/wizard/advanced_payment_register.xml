<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="advanced_payment_register_wizard_view_form" model="ir.ui.view">
        <field name="name">advanced.payment.register.wizard.view.form</field>
        <field name="model">advanced.payment.register.wizard</field>
        <field name="arch" type="xml">
            <form string="Register Payment">
                <sheet>
                    <group>
                        <group>
                            <field name="company_id" invisible="1"/>
                            <field name="payment_type" invisible="1"/>
                            <field name="available_payment_method_line_ids" invisible="1"/>
                            <field name="journal_id"/>
                            <field name="payment_method_line_id"/>
                            <field name="partner_id" invisible="1"/>
                        </group>
                        <group>
                            <field name="payment_date"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="amount"/>
                            <field name="currency_id" groups="base.group_multi_currency"/>
                            <field name="memo"/>
                            <field name="contract_id" invisible="1"/>
                            <field name="contract_invoice_id" invisible="1"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button string="Register Payment" type="object" name="action_register_payment" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
