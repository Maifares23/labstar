<odoo>
    <template id="website_sale_address_inherit" inherit_id="website_sale.address" name="Address Management with Area">
        <xpath expr="//form" position="replace">
            <form
                action="/shop/address/submit"
                method="post"
                class="checkout_autoformat"
                t-att-data-company-country-code="res_company.country_id.code"
            >
                <t t-if="is_anonymous_cart">
                    <div id="div_email_public" t-attf-class="col-lg-12">
                        <label class="col-form-label" for="o_email">Email</label>
                        <div
                            t-if="website.account_on_checkout != 'disabled'"
                            class="align-items-center float-end"
                            style="margin-top: -11px"
                        >
                            <span>Already have an account?</span>
                            <a
                                role="button"
                                href='/web/login?redirect=/shop/checkout'
                                class="btn btn-primary"
                            >
                                Sign in
                            </a>
                        </div>
                        <input
                            id="o_email"
                            type="email"
                            name="email"
                            class="form-control"
                            t-att-value="partner_sudo.email"
                        />
                    </div>
                    <h4 class="mb-1 mt-5">Fill in your address</h4>
                </t>
                <div class="row">
                    <div id="div_name" class="col-lg-12 mb-2">
                        <label class="col-form-label" for="o_name">Full name <span class="text-danger">*</span></label>
                        <input
                            id="o_name"
                            type="text"
                            name="name"
                            t-att-value="partner_sudo.name"
                            class="form-control"
                        />
                    </div>
                    <div class="w-100"/>
                    <div id="div_phone" class="col-lg-6 mb-2">
                        <label class="col-form-label" for="o_phone">Phone Number<span class="text-danger">*</span></label>
                        <span id="phone_error" style="color:red; display:none;">Invalid phone number</span>
                        <input
                            id="o_phone"
                            type="tel"
                            name="phone"
                            t-att-value="partner_sudo.phone"
                            class="form-control"
                        />
                    </div>
                    <div id="div_mobile" class="col-lg-6 mb-2">
                        <label class="col-form-label" for="o_mobile">Alternate Phone</label>
                        <span id="mobile_error" style="color:red; display:none;">Invalid Alternate Phone</span>

                        <input
                            id="o_mobile"
                            type="tel"
                            name="mobile"
                            t-att-value="partner_sudo.mobile"
                            class="form-control"
                            t-att-required="0"
                        />
                    </div>
                    <div
                        t-if="not is_anonymous_cart"
                        id="div_email"
                        class="col-lg-6 mb-2"
                    >
                        <label class="col-form-label" for="o_email">Email</label>
                        <input
                            id="o_email"
                            type="email"
                            name="email"
                            t-att-value="partner_sudo.email"
                            class="form-control"
                        />
                    </div>
                    <div id="div_street" class="col-lg-12 mb-2 d-none">
                        <label class="col-form-label" for="o_street">Street and Number</label>
                        <input id="o_street" type="text" name="street" class="form-control" t-att-value="partner_sudo.street"/>
                    </div>
                    <div id="div_street2" class="col-lg-12 mb-2 d-none" style="display: none;">
                        <label class="col-form-label label-optional" for="o_street2">Apartment, suite, etc.</label>
                        <input id="o_street2" type="text" name="street2" class="form-control" t-att-value="partner_sudo.street2" />
                    </div>
                    <div class="w-100"/>
                    <t t-if="zip_before_city" t-esc="None" class="d-none">
                        <div id="div_zip" class="col-md-4 mb-2 d-none">
                            <label class="col-form-label label-optional" for="o_zip">Zip Code</label>
                            <input id="o_zip" type="text" name="zip" class="form-control" t-att-value="partner_sudo.zip" />
                        </div>
                    </t>
                    <div id="div_city" class="col-md-8 mb-2 d-none" >
                        <label class="col-form-label" for="o_city"> City <span class="text-danger">*</span></label>
                        <input id="o_city" type="text" name="city" class="form-control" t-att-value="partner_sudo.city" />
                    </div>
                    <t t-if="not zip_before_city" class="d-none">
                        <div id="div_zip" class="col-md-4 mb-2 d-none">
                            <label class="col-form-label label-optional" for="o_zip">Zip Code</label>
                            <input id="o_zip" type="text" name="zip" class="form-control" t-att-value="partner_sudo.zip"/>
                        </div>
                    </t>
                    <div class="w-100"/>
                    <div id="div_country" class="col-lg-6 mb-2">
                        <label class="col-form-label" for="o_country_id">Country <span class="text-danger">*</span></label>
                        <select id="o_country_id" name="country_id" class="form-select">
                            <option value="">Country...</option>
                            <t t-foreach="countries" t-as="c">
                                <t t-if="c.code == 'EG'">
                                    <option t-att-value="c.id" t-att-selected="c.id == country.id" t-att-code="c.code">
                                        <t t-esc="c.name" />
                                    </option>
                                </t>
                            </t>
                        </select>
                    </div>
                    <div id="div_state" class="col-lg-6 mb-2"
                         t-att-style="not country_states and 'display: none'">
                        <label class="col-form-label" for="o_country_id">City <span class="text-danger">*</span></label>
                        <select id="o_state_id" name="state_id" class="form-select">
                            <option value="">City...</option>
                            <t t-foreach="country_states" t-as="s">
                                <t t-if="s.show_in_website and s.language and s.language == request.context.get('lang')">
                                    <option t-att-value="s.id" t-att-selected="s.id == state_id">
                                        <t t-esc="s.name" />
                                    </option>
                                </t>
                            </t>
                        </select>
                    </div>
                    <div class="form-group" id="div_area" t-att-style="not state_areas and 'display: none' or (not div_state and 'display: block')">
                        <label for="area_id">Area</label>
                        <select name="area_id" id="area_id" class="form-control">
                            <option value="">Select Area</option>
                            <t t-foreach="state_areas" t-as="area">
                            <option t-att-value="area.id" t-esc="area.name" t-att-selected="area.id == area_id"/>
                            </t>
                        </select>
                    </div>
                    <t t-if="website._display_partner_b2b_fields()">
                        <div class="w-100"/>
                        <t class="d-none">
                            <div id="full_address_div" class="col-lg-6 mb-2">
                                <label class="col-form-label" for="o_full_address"> Full Address <span class="text-danger">*</span></label>
                                <input
                                    id="o_full_address"
                                    type="text"
                                    name="full_address"
                                    t-att-value="partner_sudo.full_address"
                                    class="form-control"
                                     required=""
                                />
                            </div>
                            <div id="div_additional_notes" class="col-lg-6 mb-2">
                                <label class="col-form-label fw-normal label-optional" for="o_additional_notes">
                                    Additional Notes
                                </label>
                                <input
                                    type="text"
                                    id="o_additional_notes"
                                    name="additional_notes"
                                    t-att-value="partner_sudo.additional_notes"
                                    class="form-control"
                                />
                            </div>
                        </t>
                    </t>
                </div>
                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()" t-nocache="The csrf token must always be up to date."/>
                <input type="hidden" name="address_type" t-att-value="address_type"/>
                <input
                    type="hidden"
                    name="use_delivery_as_billing"
                    t-att-value="use_delivery_as_billing"
                />
                <t t-if="partner_id">
                    <input type="hidden" name="partner_id" t-att-value="partner_id"/>
                </t>
                <t t-if="callback">
                    <input type="hidden" name="callback" t-att-value="callback"/>
                </t>

                <!-- Example -->
                <input type="hidden" name="required_fields" t-att-value="'name,country_id'"/>

                <div class="d-flex flex-column flex-md-row align-items-center justify-content-between mt32 mb32">
                    <a role="button" t-att-href="discard_url" class="btn btn-outline-secondary w-100 w-md-auto order-md-1 order-3">
                        <i class="fw-light fa fa-angle-left me-2"/>Discard
                    </a>
                    <div class="position-relative w-100 d-flex d-md-none justify-content-center align-items-center order-2 my-2 opacity-75">
                        <hr class="w-100"/>
                        <span class="px-3">or</span>
                        <hr class="w-100"/>
                    </div>
                    <button id="save_address" class="btn btn-primary w-100 w-md-auto order-1 order-md-3">
                        <t t-if="is_anonymous_cart">
                            Continue checkout
                        </t>
                        <t t-else="">
                            Save address
                        </t>
                        <i class="fw-light fa fa-angle-right ms-2"/>
                    </button>
                </div>
            </form>
        </xpath>
    </template>
</odoo>