<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_extends_add_PDC_button" model="ir.ui.view">
        <field name="name">view.move.form.extends.add.PDC.button</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <button id="account_invoice_payment_btn" position="after">
                <button name="%(pdc_payment_wizard_action)d" id="pdc_payment_btn" type="action"
                        string="Register PDC Cheque" invisible="state != 'posted' or amount_residual == 0"
                        groups="account.group_account_invoice" class="oe_highlight"/>
            </button>

            <xpath expr="//div[@name='button_box']" position="after">
                <button class="oe_stat_button" type="object" name="action_get_pdc_payments"
                        icon="fa-files-o"
                        invisible="pdc_payments_count == 0 or move_type not in ['out_invoice', 'out_refund','in_invoice', 'in_refund']">
                    <field string="PDC Payments" name="pdc_payments_count" widget="statinfo"/>
                </button>
                <button class="oe_stat_button" type="object" name="action_get_batch_pdc_payments"
                        icon="fa-files-o"
                        invisible="batch_pdc_payments_count == 0 or move_type not in ['out_invoice', 'out_refund','in_invoice', 'in_refund']">
                    <field string="Batch PDC Payments" name="batch_pdc_payments_count" widget="statinfo"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>