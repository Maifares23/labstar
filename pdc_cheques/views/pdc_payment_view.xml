<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_pdc_payment_invoice_view" model="ir.ui.view">
            <field name="name">view.pdc.payment.invoice.view</field>
            <field name="model">pdc.payment</field>
            <field name="arch" type="xml">
                <form string="PDC Payment">
                    <sheet>
                        <group>
                            <field name="invoice_ids" invisible="1"/>
                            <field name="state" invisible="1"/>
                            <group>
                                <field name="partner_id" readonly="1"/>
                                <label for="amount"/>
                                <div name="amount_div" class="o_row">
                                    <field name="amount" readonly="1"/>
                                    <field name="currency_id" options="{'no_create': True, 'no_open': True}"
                                           groups="base.group_multi_currency" readonly="1"/>
                                </div>
                                <field name="cheque_ref" required="1"/>
                                <field name="journal_id" options="{'no_open':True,'no_create':True}"/>
                                <field name="deposit_journal_id" options="{'no_open':True,'no_create':True}"/>
                                <field name="available_journal_ids" invisible="1"/>
                            </group>
                            <group>
                                <field name="payment_date"/>
                                <field name="due_date"/>
                                <field name="deposit_date"/>
                                <field name="bounce_date"/>
                                <field name="return_date"/>
                                <field name="communication"/>
                                <field name="agent"/>
                                <field name="bank"/>
                                <field name="physically_received"/>
                                <field name="company_id" groups="base.group_multi_company"/>
                            </group>
                        </group>
                    </sheet>
                    <footer>
                        <button string='Register PDC Cheque' name="action_register" type="object" context="{'pdc':1}"
                                class="btn-primary"/>
                        <button string="Cancel" class="btn-default" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_pdc_payment"
                model="ir.actions.act_window">
            <field name="name">PDC Payment</field>
            <field name="res_model">pdc.payment</field>
            <field name="view_mode">form</field>
            <field name="view_id" ref="view_pdc_payment_invoice_view"/>
            <field name="context">{'default_invoice_ids': [(4, active_id, None)]}
            </field>
            <field name="target">new</field>
        </record>

        <record id="pdc_payment_list" model="ir.ui.view">
            <field name="name">pdc.payment.list</field>
            <field name="model">pdc.payment</field>
            <field name="arch" type="xml">
                <list decoration-info="state=='draft'" decoration-muted="state=='reconciled'" multi_edit="1" sample="1">
                    <field name="cheque_ref"/>
                    <field name="partner_id" readonly="state != 'draft'"/>
                    <field name="payment_date" readonly="state not in ['bounce','draft']"/>
                    <field name="due_date" readonly="state not in ['bounce','draft']"/>
                    <field name="deposit_date" readonly="state not in ['register','bounce','draft']"/>
                    <field name="bounce_date" readonly="state not in ['register','deposit','draft']"/>
                    <field name="return_date" readonly="state not in ['register','bounce','draft']"/>
                    <field name="collection_date" readonly="state in ['done','return','cancel']"/>
                    <field name="journal_id" options="{'no_open':True,'no_create':True}"
                           readonly="state != 'draft'"/>
                    <field name="amount" sum="Amount" readonly="state != 'draft'"/>
                    <field name="state"/>
                    <field name="company_id" column_invisible="1"/>
                    <field name="currency_id" column_invisible="1"/>
                    <field name="payment_type" column_invisible="1"/>
                    <field name="available_journal_ids" column_invisible="1"/>
                </list>
            </field>
        </record>


        <record id="pdc_payment_form" model="ir.ui.view">
            <field name="name">pdc.payment.form</field>
            <field name="model">pdc.payment</field>
            <field name="arch" type="xml">
                <form string="PDC Payment">
                    <header>
                        <button name="action_register" class="oe_highlight" invisible="state != 'draft'"
                                string="Register" type="object"/>
                        <button name="action_return_cheque" class="oe_highlight"
                                string="Return" type="object" invisible="state not in ['register','bounce']"/>
                        <button name="action_deposit" class="oe_highlight" string="Deposit"
                                type="object"
                                invisible="state not in ['register', 'bounce']"/>
                        <button name="action_done" class="oe_highlight" string="Collected"
                                type="object" invisible="state not in ['deposit']"/>
                        <button name="action_cancel" class="oe_highlight" invisible="state != 'draft'" string="Cancel"
                                type="object"/>
                        <button name="action_reset_to_draft" class="oe_highlight" invisible="state == 'draft'"
                                string="Reset to Draft" type="object"/>
                        <button name="action_bounce" class="oe_highlight" string="Bounce"
                                type="object" invisible="state != 'deposit'"/>
                        <field name="state" widget="statusbar"
                               statusbar_visible="draft,register,bounce,return,deposit,done,cancel"/>
                    </header>
                    <sheet>
                        <div name="button_box" class="oe_button_box">
                            <button name="action_get_journal_entries" class="oe_stat_button" icon="fa-bars"
                                    type="object" string="PDC Entries">
                            </button>
                            <button name="action_get_invoices" class="oe_stat_button" icon="fa-files-o" type="object"
                                    invisible="state == 'draft' or payment_type == 'outbound'" string="PDC Invoices">
                            </button>
                            <button name="action_get_bills" class="oe_stat_button" icon="fa-file" type="object"
                                    invisible="state == 'draft' or payment_type == 'inbound'"
                                    string="PDC Bills">
                            </button>
                        </div>
                        <group>
                            <field name="invoice_ids" invisible="1"/>
                            <group>
                                <field name="name" readonly="1"/>
                                <field name="payment_type" widget="radio"
                                       readonly="state != 'draft'"/>
                                <field name="partner_id"
                                       context="{'default_supplier': payment_type == 'outbound', 'default_customer': payment_type == 'inbound'}"
                                       readonly="state != 'draft'"/>
                                <label for="amount"/>
                                <div name="amount_div" class="o_row">
                                    <field name="amount"
                                           readonly="state != 'draft'"/>
                                    <field name="currency_id" options="{'no_create': True, 'no_open': True}"
                                           groups="base.group_multi_currency"
                                           readonly="state != 'draft'"/>
                                </div>
                                <field name="cheque_ref" required="1"/>
                                <field name="journal_id" options="{'no_open':True,'no_create':True}"
                                       readonly="state != 'draft'"/>
                                <field name="deposit_journal_id" options="{'no_open':True,'no_create':True}"
                                       readonly="state not in ['deposit','register','draft']"/>
                                <field name="available_journal_ids" invisible="1"/>

                            </group>
                            <group>
                                <field name="payment_date" readonly="state not in ['bounce','draft']"/>
                                <field name="due_date" readonly="state not in ['bounce','draft']"/>
                                <field name="collection_date" readonly="state in ['done','return','cancel']"/>
                                <field name="deposit_date" readonly="state not in ['register','bounce','draft']"/>
                                <field name="bounce_date" readonly="state not in ['register','deposit','draft']"/>
                                <field name="return_date" readonly="state not in ['register','bounce','draft']"/>
                                <field name="communication"
                                       readonly="state != 'draft'"/>
                                <field name="agent"
                                       readonly="state != 'draft'"/>
                                <field name="bank"
                                       readonly="state != 'draft'"/>
                                <field name="physically_received" readonly="state in ['done','return']"/>
                                <field name="company_id" groups="base.group_multi_company"
                                       readonly="state != 'draft'"/>
                            </group>
                        </group>
                    </sheet>
                    <!-- Chatter -->
                    <chatter/>
                </form>
            </field>
        </record>


        <record id="pdc_payment_search" model="ir.ui.view">
            <field name="name">pdc.payment.search</field>
            <field name="model">pdc.payment</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name"/>
                    <field name="partner_id"/>
                    <field name="journal_id"/>
                    <field name="amount"/>
                    <field name="payment_type"/>
                    <field name="payment_date"/>
                    <field name="due_date"/>
                    <field name="deposit_date"/>
                    <field name="bounce_date"/>
                    <field name="return_date"/>
                    <field name="communication"/>
                    <field name="cheque_ref"/>
                    <field name="agent"/>
                    <field name="bank"/>

                    <filter string="Received Cheques" name="received_cheques"
                            domain="[('payment_type', '=', 'inbound')]"/>
                    <filter string="Issued Cheques" name="issued_cheques" domain="[('payment_type', '=', 'outbound')]"/>
                    <separator/>
                    <filter string="Payment Date" name="payment_date" date="payment_date"/>
                    <filter string="Due Date" name="due_date" date="due_date"/>
                    <filter string="Collection Date" name="collection_date" date="collection_date"/>
                    <separator/>
                    <filter string="Deposit Date" name="deposit_date" date="deposit_date"/>
                    <filter string="Bounce Date" name="bounce_date" date="bounce_date"/>
                    <filter string="Return Date" name="return_date" date="return_date"/>

                    <group expand="0" string="Group By">
                        <filter string="Payment Date" name="group_by_payment_date" domain="[]"
                                context="{'group_by': 'payment_date'}"/>
                        <filter string="Due Date" name="group_by_due_date" domain="[]"
                                context="{'group_by': 'due_date'}"/>
                        <filter string="Collection Date" name="group_by_collection_date" domain="[]"
                                context="{'group_by': 'collection_date'}"/>
                        <separator/>
                        <filter string="Deposit Date" name="group_by_deposit_date" domain="[]"
                                context="{'group_by': 'deposit_date'}"/>
                        <filter string="Bounce Date" name="group_by_bounce_date" domain="[]"
                                context="{'group_by': 'bounce_date'}"/>
                        <filter string="Return Date" name="group_by_return_date" domain="[]"
                                context="{'group_by': 'return_date'}"/>
                        <separator/>
                        <filter string="Partner" name="group_by_partner_id" domain="[]"
                                context="{'group_by': 'partner_id'}"/>
                        <filter string="Payment Type" name="group_by_payment_type" domain="[]"
                                context="{'group_by': 'payment_type'}"/>
                        <filter string="Payment Journal" name="group_by_journal_id" domain="[]"
                                context="{'group_by': 'journal_id'}"/>
                        <separator/>
                        <filter string="Status" name="group_by_state" domain="[]" context="{'group_by':'state'}"/>
                    </group>
                </search>
            </field>
        </record>


        <!-- Graph View -->
        <record id="pdc_payment_graph" model="ir.ui.view">
            <field name="name">pdc.payment.graph</field>
            <field name="model">pdc.payment</field>
            <field name="type">graph</field>
            <field name="arch" type="xml">
                <graph string="PDC Payment" type="bar">
                    <field name="partner_id"/>
                    <field name="amount" type="measure"/>
                </graph>
            </field>
        </record>

        <!-- Pivot View -->
        <record id="pdc_payment_pivot" model="ir.ui.view">
            <field name="name">pdc.payment.pivot</field>
            <field name="model">pdc.payment</field>
            <field name="arch" type="xml">
                <pivot string="PDC Payment" sample="1">
                    <field name="state" type="row"/>
                    <field name="journal_id" type="measure"/>
                    <field name="name"/>
                    <field name="partner_id" string="Customer" type="measure"/>
                    <field name="payment_date"/>
                    <field name="cheque_ref"/>
                    <field name="amount"/>
                    <field name="company_id" groups="base.group_multi_company" type="measure"/>
                </pivot>
            </field>
        </record>


        <record id="action_pdc_payment_customer" model="ir.actions.act_window">
            <field name="name">Customer PDC</field>
            <field name="res_model">pdc.payment</field>
            <field name="view_id" ref="pdc_payment_list"/>
            <field name="view_mode">list,form,search,graph,pivot</field>
            <field name="context">{'default_customer_pdc': 1}</field>
            <field name="domain">[('customer_pdc','>',0)]</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Register a Post Dated Check
                </p>
            </field>
        </record>
        <record id="action_pdc_payment_vendor" model="ir.actions.act_window">
            <field name="name">Vendor PDC</field>
            <field name="res_model">pdc.payment</field>
            <field name="view_id" ref="pdc_payment_list"/>
            <field name="view_mode">list,form,search,graph,pivot</field>
            <field name="context">{'default_vendor_pdc': 1}</field>
            <field name="domain">[('vendor_pdc','>',0)]</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Register a Post Dated Check
                </p>
            </field>
        </record>

        <!-- Deposit Button in action menu -->
        <record id="model_pdc_payment_action_deposit" model="ir.actions.server">
            <field name="name">Deposit</field>
            <field name="type">ir.actions.server</field>
            <field name="model_id" ref="pdc_cheques.model_pdc_payment"/>
            <field name="binding_model_id" ref="pdc_cheques.model_pdc_payment"/>
            <field name="binding_view_types">list</field>
            <field name="state">code</field>
            <field name="code">records.action_deposit()</field>
        </record>

        <!-- Done Button in action menu -->
        <record id="model_pdc_payment_action_done" model="ir.actions.server">
            <field name="name">Collected</field>
            <field name="type">ir.actions.server</field>
            <field name="model_id" ref="pdc_cheques.model_pdc_payment"/>
            <field name="binding_model_id" ref="pdc_cheques.model_pdc_payment"/>
            <field name="binding_view_types">list</field>
            <field name="state">code</field>
            <field name="code">records.action_done()</field>
        </record>

        <!-- Reset to draft Button in action menu -->
        <record id="model_pdc_payment_action_reset_to_draft" model="ir.actions.server">
            <field name="name">Reset to Draft</field>
            <field name="type">ir.actions.server</field>
            <field name="model_id" ref="pdc_cheques.model_pdc_payment"/>
            <field name="binding_model_id" ref="pdc_cheques.model_pdc_payment"/>
            <field name="binding_view_types">list</field>
            <field name="state">code</field>
            <field name="code">records.action_reset_to_draft()</field>
        </record>


        <!-- Bounce Button in action menu -->
        <record id="model_pdc_payment_action_bounce" model="ir.actions.server">
            <field name="name">Bounce</field>
            <field name="type">ir.actions.server</field>
            <field name="model_id" ref="pdc_cheques.model_pdc_payment"/>
            <field name="binding_model_id" ref="pdc_cheques.model_pdc_payment"/>
            <field name="binding_view_types">list</field>
            <field name="state">code</field>
            <field name="code">records.action_bounce()</field>
        </record>


        <!-- Return Button in action menu -->
        <record id="model_pdc_payment_action_return" model="ir.actions.server">
            <field name="name">Return</field>
            <field name="type">ir.actions.server</field>
            <field name="model_id" ref="pdc_cheques.model_pdc_payment"/>
            <field name="binding_model_id" ref="pdc_cheques.model_pdc_payment"/>
            <field name="binding_view_types">list</field>
            <field name="state">code</field>
            <field name="code">records.action_return_cheque()</field>
        </record>


        <!-- Register Button in action menu -->
        <record id="model_pdc_payment_action_register" model="ir.actions.server">
            <field name="name">Register</field>
            <field name="type">ir.actions.server</field>
            <field name="model_id" ref="pdc_cheques.model_pdc_payment"/>
            <field name="binding_model_id" ref="pdc_cheques.model_pdc_payment"/>
            <field name="binding_view_types">list</field>
            <field name="state">code</field>
            <field name="code">records.action_register()</field>
        </record>


        <!-- Cancel Button in action menu -->
        <record id="model_pdc_payment_action_cancel" model="ir.actions.server">
            <field name="name">Cancel</field>
            <field name="type">ir.actions.server</field>
            <field name="model_id" ref="pdc_cheques.model_pdc_payment"/>
            <field name="binding_model_id" ref="pdc_cheques.model_pdc_payment"/>
            <field name="binding_view_types">list</field>
            <field name="state">code</field>
            <field name="code">records.action_cancel()</field>
        </record>


        <menuitem id="menu_finance_pdc" name="Post Dated Cheques" parent="accountant.menu_accounting"
                  sequence="3"/>
        <menuitem action="action_pdc_payment_customer" id="menu_pdc_payment_customer" parent="menu_finance_pdc"
                  sequence="1"/>
        <menuitem action="action_pdc_payment_vendor" id="menu_pdc_payment_vendor" parent="menu_finance_pdc"
                  sequence="1"/>
    </data>
</odoo>