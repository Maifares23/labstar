<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="reconcile_cash_custody_list" model="ir.ui.view">
            <field name="name">reconcile.cash.custody.list</field>
            <field name="model">reconcile.cash.custody</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                    <field name="requester_id"/>
                    <field name="date"/>
                    <field name="state"/>
                </list>
            </field>
        </record>

        <record id="reconcile_cash_custody_form" model="ir.ui.view">
            <field name="name">reconcile.cash.custody.form</field>
            <field name="model">reconcile.cash.custody</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <button name="action_sent_to_confirmation" string="Sent To Confirmation" class="btn-primary"
                                invisible="state != 'draft'" type="object"/>
                        <button name="action_submit" string="Submit" class="btn-primary"
                                invisible="state != 'sent_to_confirmation'"
                                type="object"/>
                        <button name="action_confirm" string="Confirm" class="btn-primary"
                                invisible="state != 'submit'"
                                type="object"/>
                        <button name="action_reconciled" string="Reconcile" class="btn-primary"
                                invisible="state != 'confirm'"
                                type="object"/>
                        <field name="state" widget="statusbar"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="view_journal_entry_button" type="object" class="oe_stat_button"
                                    icon="fa-bars" invisible="journal_entry_count == 0">
                                <field name="journal_entry_count" widget="statinfo" string="Journal Entries"/>
                            </button>
                        </div>
                        <h1>
                            <field name="name" readonly="1" force_save="1"/>
                        </h1>
                        <group>
                            <group>
                                <field name="requester_id" readonly="state in ['confirm','reconciled']"
                                       force_save="1"/>
                                <field name="date" readonly="state in ['confirm','reconciled']"
                                       force_save="1"/>
                            </group>
                            <group>
                                <field name="journal_id"
                                       invisible="state not in ['confirm','reconciled']"
                                       readonly="state == 'reconciled'" required="state == 'confirm'"
                                       force_save="1"/>
                                <field name="credit_account_id"
                                       invisible="state not in ['confirm','reconciled']"
                                       readonly="state == 'reconciled'" required="state == 'confirm'"
                                       force_save="1"/>
                            </group>
                        </group>
                        <notebook>
                            <page name="reconcile_custody_lines" string="Items">
                                <field name="reconcile_custody_lines_ids" readonly="state in ['confirm', 'reconciled']"
                                       force_save="1">
                                    <list editable="bottom">
                                        <field name="account_id" readonly="1" force_save="1"/>
                                        <field name="project_id" readonly="1" force_save="1"/>
                                        <field name="reconciled_amount"/>
                                        <field name="request_custody_line_id" invisible="0"/>
                                        <field name="amount" readonly="1" force_save="1"/>
                                    </list>
                                </field>
                                <group class="oe_subtotal_footer oe_right" colspan="2">
                                    <field name="total_reconciled_amount"/>
                                </group>
                            </page>

                        </notebook>
                    </sheet>
<!--                    <div class="oe_chatter">-->
<!--                        <field name="message_follower_ids" widget="mail_followers"/>-->
<!--                        <field name="activity_ids" widget="mail_activity"/>-->
<!--                        <field name="message_ids" widget="mail_thread"/>-->
<!--                    </div>-->
                    <chatter/>
                </form>
            </field>
        </record>
        <record id="reconcile_cash_custody_action" model="ir.actions.act_window">
            <field name="name">Reconcile Custody</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">reconcile.cash.custody</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p>
                    <!-- More details about what a user can do with this object will be OK -->
                </p>
            </field>
        </record>
        <menuitem id="reconcile_cash_custody_menu" parent="cash_custody_menu" action="reconcile_cash_custody_action"
                  sequence="2"/>

    </data>
</odoo>