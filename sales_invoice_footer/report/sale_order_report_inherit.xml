<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_saleorder_document_inherit" inherit_id="sale.report_saleorder_document">
        <xpath expr="//div[hasclass('page')]" position="inside">
            <t t-if="doc.company_id.show_bank_footer_on_sale_order">
                <t t-call="sales_invoice_footer.report_bank_footer">
                    <t t-set="bank" t-value="doc.company_id.footer_bank_account_id"/>
                </t>
            </t>
        </xpath>
    </template>
</odoo>
