<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="paperformat_bank_footer" model="report.paperformat">
        <field name="name">A4 - Bank Footer</field>
        <field name="format">A4</field>
        <field name="page_height">0</field>
        <field name="page_width">0</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">52</field>
        <field name="margin_bottom">55</field>
        <field name="margin_left">0</field>
        <field name="margin_right">0</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">52</field>
        <field name="dpi">90</field>
        <field name="css_margins" eval="True"/>
    </record>

    <record id="sale.action_report_saleorder" model="ir.actions.report">
        <field name="paperformat_id" ref="sales_invoice_footer.paperformat_bank_footer"/>
    </record>

    <record id="account.account_invoices" model="ir.actions.report">
        <field name="paperformat_id" ref="sales_invoice_footer.paperformat_bank_footer"/>
    </record>
</odoo>
