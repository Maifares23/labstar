<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_invoice_document_inherit" inherit_id="account.report_invoice_document">
        <xpath expr="//div[hasclass('page')]" position="inside">
            <t t-if="o.company_id.show_bank_footer_on_invoice">
                <t t-call="sales_invoice_footer.report_bank_footer">
                    <t t-set="bank" t-value="o.company_id.footer_bank_account_id"/>
                </t>
            </t>
        </xpath>
    </template>
</odoo>
