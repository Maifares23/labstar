<odoo>
    <data>
        <record id="view_contract_down_payment_list" model="ir.ui.view">
            <field name="name">contract.down.payment.list</field>
            <field name="model">contract.down.payment</field>
            <field name="arch" type="xml">
                <list string="Contract Down Payments">
                    <field name="name"/>
                    <field name="partner_id"/>
                    <field name="amount"/>
                    <field name="state"/>
                    <field name="invoice_id"/>
                </list>
            </field>
        </record>

        <record id="view_contract_down_payment_form" model="ir.ui.view">
            <field name="name">contract.down.payment.form</field>
            <field name="model">contract.down.payment</field>
            <field name="arch" type="xml">
                <form string="Contract Down Payment">
                    <header>
                        <button name="action_confirm" string="Confirm &amp; Pay" type="object"
                                invisible="state!='draft'" class="btn-primary" groups="ids_realstate_update.confirm_down_payment_group"/>
                        <button name="action_cancel" string="Cancel" type="object"
                                invisible="state!='draft'" class="btn-secondary"/>
                        <field name="state" widget="statusbar" statusbar_visible="draft,done,cancel"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_view_invoice"
                                    type="object"
                                    class="oe_stat_button"
                                    icon="fa-refresh">
                                <div class="o_field_widget o_stat_info">
                                    <span class="o_stat_text">Invoice</span>
                                </div>
                            </button>
                        </div>
                        <group>
                            <group>
                                <field name="name" readonly="1" force_save="1"/>
                                <field name="partner_id" readonly="state in ['done','cancel']" force_save="1"/>
                                <field name="date" readonly="state in ['done','cancel']" force_save="1"/>
                                <field name="amount" readonly="state in ['done','cancel']" force_save="1"/>
                                <field name="paid_amount" readonly="1" force_save="1"/>
                                <field name="remaining_amount" readonly="1" force_save="1"/>
                            </group>
                            <group>
                                <field name="journal_id" readonly="state in ['done','cancel']" force_save="1"/>
                                <field name="invoice_id" readonly="1" force_save="1"/>
                                <field name="contract_state" readonly="1" force_save="1"/>
                                <field name="tax_id" readonly="state in ['done','cancel']" force_save="1"/>
                            </group>
                        </group>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>
    </data>
</odoo>
