<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="business_unit_form_view_id" model="ir.ui.view">
            <field name="name">business.unit.form.view</field>
            <field name="model">business.unit</field>
            <field name="arch" type="xml">
                <form string="">
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="name" readonly="0" placeholder="Business Unit Name"/>
                            </h1>
                        </div>
                        <group>
                            <field name="name"/>
                            <field name="manager_id"/>
                            <field name="project_id" invisible="1"/>
                        </group>
                    </sheet>
<!--                    <div class="oe_chatter">-->
<!--                        <field name="message_follower_ids" widget="mail_followers"/>-->
<!--                        <field name="activity_ids" widget="mail_activity"/>-->
<!--                        <field name="message_ids" widget="mail_thread"/>-->
<!--                    </div>-->
                </form>
            </field>
        </record>

        <record id="business_unit_tree_view_id" model="ir.ui.view">
            <field name="name">business.unit.tree.view</field>
            <field name="model">business.unit</field>
            <field name="arch" type="xml">
                <list string="" editable="bottom">
                    <field name="name"/>
                    <field name="manager_id"/>
                </list>
            </field>
        </record>

        <record id="business_unit_action_id" model="ir.actions.act_window">
            <field name="name">Business Unit</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">business.unit</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
              <p class="oe_view_nocontent_create">
                <!-- Add Text Here -->
              </p><p>
                <!-- More details about what a user can do with this object will be OK -->
              </p>
            </field>
        </record>


        <!-- This Menu Item Must have a parent -->
        <menuitem id="configuration_menu_id" name="Configuration" parent="smac_construction_management.spm_menu_categ_id" sequence="10"/>
        <!-- This Menu Item must have a parent and an action -->
        <menuitem id="business_unit_menu_id" name="Business Unit" parent="smac_construction_management.configuration_menu_id" action="business_unit_action_id" sequence="1"/>

    </data>
</odoo>