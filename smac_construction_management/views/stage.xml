            <field name="name">work.flow.tree.view</field>
            <field name="model">stage</field>
            <field name="arch" type="xml">
                <list>
                    <field name="sequence" widget="handle" optional="show"/>
                    <field name="name"/>
                    <field name="company_id" invisible="1"/>
                    <field name="group_ids" widget="many2many_tags"/>
                    <field name="due_days"/>
                    <field name="workflow_id"/>
                </list>
            </field>
        </record>

        <record id="stage_action_id" model="ir.actions.act_window">
            <field name="name">Stage</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">stage</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">
                    <!-- Add Text Here -->
                </p>
                <p>
                    <!-- More details about what a user can do with this object will be OK -->
                </p>
            </field>
        </record>


        <!-- This Menu Item must have a parent and an action -->
        <menuitem id="stage_menu_id" name="Stage" parent="smac_construction_management.configuration_menu_id"
                  action="stage_action_id" sequence="1"/>

