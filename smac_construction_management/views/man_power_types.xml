<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>


        <record id="man_power_types_tree_view_id" model="ir.ui.view">
            <field name="name">man.power.types.tree.view</field>
            <field name="model">man.power.types</field>
            <field name="arch" type="xml">
                <list string="">
                    <field name="name"/>
                    <field name="project_id"/>
                </list>
            </field>
        </record>


        <record id="man_power_types_search_view_id" model="ir.ui.view">
            <field name="name">man.power.types.search.view</field>
            <field name="model">man.power.types</field>
            <field name="arch" type="xml">
                <search string="">
                    <field name="name"/>
                    <field name="project_id"/>
                </search>
            </field>
        </record>

        <record id="man_power_types_form_view_id" model="ir.ui.view">
            <field name="name">man.power.types.form.view</field>
            <field name="model">man.power.types</field>
            <field name="arch" type="xml">
                <form string="Man Power Types" name="man_power_types">
                    <sheet>
                        <group>
                            <group>
                                <field name="name" />
                            </group>
                            <group>
                                <field name="project_id"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>


        <record id="man_power_types_action_id" model="ir.actions.act_window">
            <field name="name">Man Power Types</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">man.power.types</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">
                    <!-- Add Text Here -->
                </p>
                <p>
                    <!-- More details about what a user can do with this object will be OK -->
                </p>
            </field>
        </record>

        <!-- This Menu Item must have a parent and an action -->
        <menuitem id="man_power_types_menu_id" name="Man Power Types"
                  parent="smac_construction_management.configuration_menu_id" action="man_power_types_action_id"
                  sequence="13"/>


    </data>
</odoo>