<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="account_analytic_plan_form_view_inh" model="ir.ui.view">
            <field name="name">account.analytic.plan.inhform</field>
            <field name="model">account.analytic.plan</field>
            <field name="inherit_id" ref="analytic.account_analytic_plan_form_view"/>
            <field name="arch" type="xml">
                <data>
                    <xpath expr="//field[@name='color']" position="after">
                        <field name="business_unit_id" invisible="1"/>
                    </xpath>
                </data>
            </field>
        </record>
    </data>
</odoo>